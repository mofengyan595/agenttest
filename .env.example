# CLI uses explicit settings. The normal web workspace reads model settings and
# AGENTTEST_TARGET_* aliases from the repository .env; never executes its contents.
# Set these in the shell only when separately launching the local mini target.
# The offline demo generates temporary credentials in memory instead.
DEMO_ALICE_USERNAME=
DEMO_ALICE_PASSWORD=
DEMO_BOB_USERNAME=
DEMO_BOB_PASSWORD=

# Stage 2A: real planner only, explicitly load with --model-env .env.
# No default provider/model. Use your operator-approved endpoint and model ID.
# ChatECNU configuration is described in docs/model-configuration.md.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENTTEST_MODEL=

# Optional credentials for a generic web project. The form stores names only.
AGENTTEST_TARGET_BEARER_1=
AGENTTEST_TARGET_USERNAME=
AGENTTEST_TARGET_PASSWORD=

# Stage 1 uses explicit target JSON; .env is not automatically loaded.
# Set these in the shell only when separately launching the local mini target.
# The offline demo generates temporary credentials in memory instead.
DEMO_ALICE_USERNAME=
DEMO_ALICE_PASSWORD=
DEMO_BOB_USERNAME=
DEMO_BOB_PASSWORD=

# Reserved for Stage 2; not read or needed by the Stage 1 application.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENTTEST_MODEL=

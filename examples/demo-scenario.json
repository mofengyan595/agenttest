{
  "name": "Reviewed mini target login, ownership and asynchronous CSV scenario",
  "steps": [
    {
      "id": "login_alice",
      "operation_id": "login",
      "role": "alice",
      "policy_id": "login_alice_v1"
    },
    {
      "id": "login_bob",
      "operation_id": "login",
      "role": "bob",
      "policy_id": "login_bob_v1"
    },
    {
      "id": "create_course",
      "operation_id": "createCourse",
      "role": "alice",
      "body": {
        "name": {
          "value": "AgentTest disposable course"
        }
      },
      "policy_id": "create_course_v1"
    },
    {
      "id": "read_course",
      "operation_id": "getCourse",
      "role": "alice",
      "path_parameters": {
        "courseId": {
          "from_step": "create_course",
          "select": "$.courseId"
        }
      },
      "policy_id": "read_course_v1"
    },
    {
      "id": "cross_user",
      "operation_id": "getCourse",
      "role": "bob",
      "path_parameters": {
        "courseId": {
          "from_step": "create_course",
          "select": "$.courseId"
        }
      },
      "policy_id": "cross_user_v1"
    },
    {
      "id": "create_batch",
      "operation_id": "createBatch",
      "role": "alice",
      "path_parameters": {
        "courseId": {
          "from_step": "create_course",
          "select": "$.courseId"
        }
      },
      "upload": {
        "content": "text\nfirst synthetic row\nsecond synthetic row\n"
      },
      "policy_id": "create_batch_v1"
    },
    {
      "id": "poll_batch",
      "operation_id": "getBatch",
      "role": "alice",
      "path_parameters": {
        "batchId": {
          "from_step": "create_batch",
          "select": "$.batchId"
        }
      },
      "poll": true,
      "policy_id": "poll_batch_v1"
    },
    {
      "id": "batch_results",
      "operation_id": "getBatchResults",
      "role": "alice",
      "path_parameters": {
        "batchId": {
          "from_step": "create_batch",
          "select": "$.batchId"
        }
      },
      "policy_id": "batch_results_v1"
    }
  ]
}

{
  "name": "Reviewed mini target login, ownership and asynchronous CSV scenario",
  "steps": [
    {
      "id": "login_alice", "operation_id": "login", "role": "alice",
      "body": {"username": {"credential": "username"}, "password": {"credential": "password"}},
      "assertions": {"reviewed": true, "source": "docs/demo-policy.md#authentication", "status": {"codes": [200]}, "fields": [{"select": "$.access_token", "operator": "exists"}]}
    },
    {
      "id": "login_bob", "operation_id": "login", "role": "bob",
      "body": {"username": {"credential": "username"}, "password": {"credential": "password"}},
      "assertions": {"reviewed": true, "source": "docs/demo-policy.md#authentication", "status": {"codes": [200]}, "fields": [{"select": "$.access_token", "operator": "exists"}]}
    },
    {
      "id": "create_course", "operation_id": "createCourse", "role": "alice",
      "auth_from": {"from_step": "login_alice", "select": "$.access_token"},
      "body": {"name": {"value": "AgentTest disposable course"}},
      "assertions": {"reviewed": true, "source": "docs/demo-policy.md#resources", "status": {"codes": [201]}, "fields": [{"select": "$.courseId", "operator": "exists"}]}
    },
    {
      "id": "read_course", "operation_id": "getCourse", "role": "alice",
      "auth_from": {"from_step": "login_alice", "select": "$.access_token"},
      "path_parameters": {"courseId": {"from_step": "create_course", "select": "$.courseId"}},
      "assertions": {"reviewed": true, "source": "docs/demo-policy.md#resources", "status": {"codes": [200]}, "fields": [{"select": "$.name", "expected": "AgentTest disposable course"}]}
    },
    {
      "id": "cross_user", "operation_id": "getCourse", "role": "bob",
      "auth_from": {"from_step": "login_bob", "select": "$.access_token"},
      "path_parameters": {"courseId": {"from_step": "create_course", "select": "$.courseId"}},
      "assertions": {"reviewed": true, "source": "docs/demo-policy.md#ownership", "status": {"codes": [403]}}
    },
    {
      "id": "create_batch", "operation_id": "createBatch", "role": "alice",
      "auth_from": {"from_step": "login_alice", "select": "$.access_token"},
      "path_parameters": {"courseId": {"from_step": "create_course", "select": "$.courseId"}},
      "upload": {"content": "text\nfirst synthetic row\nsecond synthetic row\n"},
      "assertions": {"reviewed": true, "source": "docs/demo-policy.md#batches", "status": {"codes": [202]}, "fields": [{"select": "$.batchId", "operator": "exists"}]}
    },
    {
      "id": "poll_batch", "operation_id": "getBatch", "role": "alice",
      "auth_from": {"from_step": "login_alice", "select": "$.access_token"},
      "path_parameters": {"batchId": {"from_step": "create_batch", "select": "$.batchId"}},
      "poll": {"select": "$.state", "terminal_values": ["SUCCEEDED", "FAILED"], "max_attempts": 4, "interval": 0.01},
      "assertions": {"reviewed": true, "source": "docs/demo-policy.md#batches", "status": {"codes": [200]}, "fields": [{"select": "$.state", "expected": "SUCCEEDED"}, {"select": "$.count", "expected": 2}]}
    },
    {
      "id": "batch_results", "operation_id": "getBatchResults", "role": "alice",
      "auth_from": {"from_step": "login_alice", "select": "$.access_token"},
      "path_parameters": {"batchId": {"from_step": "create_batch", "select": "$.batchId"}},
      "assertions": {"reviewed": true, "source": "docs/demo-policy.md#batches", "status": {"codes": [200]}, "fields": [{"select": "$.items", "operator": "count", "expected": 2}]}
    }
  ]
}

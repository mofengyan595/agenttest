  "components": {
    "schemas": {
      "AttemptEvidence": {
        "properties": {
          "attempt": {
            "type": "integer",
            "title": "Attempt"
          },
          "attempt_id": {
            "type": "string",
            "title": "Attempt Id"
          },
          "status_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Code"
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms"
          },
          "response_bytes": {
            "type": "integer",
            "title": "Response Bytes",
            "default": 0
          },
          "response_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Sha256"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "type": "object",
        "required": [
          "attempt",
          "elapsed_ms"
        ],
        "title": "AttemptEvidence"
      },
      "CheckResult": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "selector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selector"
          },
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "expected": {
            "title": "Expected"
          },
          "actual": {
            "title": "Actual"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "passed"
        ],
        "title": "CheckResult"
      },
      "ContractSummary": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/Operation"
            },
            "type": "array",
            "title": "Operations"
          },
          "security_schemes": {
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "object",
            "title": "Security Schemes"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "ContractSummary"
      },
      "Diagnostic": {
        "properties": {
          "layer": {
            "$ref": "#/components/schemas/Layer"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,95}$",
            "title": "Code"
          },
          "fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Fields"
          },
          "reference": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReferenceDiagnostic"
              },
              {
                "type": "null"
              }
            ]
          },
          "intent": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/IntentDiagnostic"
                },
                "type": "array",
                "maxItems": 8
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          }
        },
        "type": "object",
        "required": [
          "layer",
          "code"
        ],
        "title": "Diagnostic"
      },
      "FeedbackDecisionEvidence": {
        "properties": {
          "index": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Index"
          },
          "action": {
            "type": "string",
            "enum": [
              "pending",
              "investigate",
              "finish",
              "rejected"
            ],
            "title": "Action",
            "default": "pending"
          },
          "reason": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,95}$",
            "title": "Reason",
            "default": "FEEDBACK_PENDING"
          },
          "model_call": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelCallStats"
              },
              {
                "type": "null"
              }
            ]
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms",
            "default": 0
          },
          "public_context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Public Context"
          },
          "proposal": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposal"
          }
        },
        "type": "object",
        "required": [
          "index"
        ],
        "title": "FeedbackDecisionEvidence"
      },
      "FeedbackResult": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "SUPPORTED",
              "NEEDS_REVIEW",
              "BUDGET_EXHAUSTED",
              "TOOL_ERROR",
              "TEST_INFRA_ERROR",
              "TIMEOUT",
              "CANCELLED"
            ],
            "title": "State",
            "default": "PENDING"
          },
          "reason": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,95}$",
            "title": "Reason",
            "default": "FEEDBACK_PENDING"
          },
          "finding": {
            "type": "string",
            "enum": [
              "ACCESS_BOUNDARY_VIOLATION",
              "PERSISTENT_READBACK_MISMATCH",
              "EVIDENCE_INSUFFICIENT"
            ],
            "title": "Finding",
            "default": "EVIDENCE_INSUFFICIENT"
          },
          "basis": {
            "type": "string",
            "enum": [
              "证据不足，需人工复核。",
              "受限角色读取成功，同资源的所有者读取通过。",
              "同角色对同一资源的复核重复出现字段断言失败。"
            ],
            "title": "Basis",
            "default": "证据不足，需人工复核。"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Evidence Refs"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/FeedbackDecisionEvidence"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Decisions"
          },
          "requests_used": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Requests Used",
            "default": 0
          },
          "model_calls_used": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Model Calls Used",
            "default": 0
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms",
            "default": 0
          }
        },
        "type": "object",
        "title": "FeedbackResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IntentDiagnostic": {
        "properties": {
          "branch": {
            "type": "string",
            "enum": [
              "STEP_COUNT",
              "OPERATION_ROLE_POLICY",
              "PARAMETERS",
              "SOURCE_OR_VALUE",
              "ORDER",
              "EXECUTION_OPTION",
              "GOAL_COVERAGE",
              "STEP_SET"
            ],
            "title": "Branch"
          },
          "requirement_index": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 19.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Requirement Index"
          }
        },
        "type": "object",
        "required": [
          "branch"
        ],
        "title": "IntentDiagnostic"
      },
      "InvestigationResult": {
        "properties": {
          "step_id": {
            "type": "string",
            "title": "Step Id"
          },
          "step_run_id": {
            "type": "string",
            "title": "Step Run Id"
          },
          "operation_id": {
            "type": "string",
            "title": "Operation Id"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "path_template": {
            "type": "string",
            "title": "Path Template"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "policy_sha256": {
            "type": "string",
            "title": "Policy Sha256"
          },
          "policy_template_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Template Sha256"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "type": "array",
            "title": "Checks"
          },
          "attempts": {
            "items": {
              "$ref": "#/components/schemas/AttemptEvidence"
            },
            "type": "array",
            "title": "Attempts"
          },
          "input_validation": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "NORMAL_VALIDATED",
                  "APPROVED_NEGATIVE"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Validation"
          },
          "negative_test": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Negative Test"
          },
          "approved_violation_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Approved Violation Codes"
          },
          "negative_rejected_as_expected": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Negative Rejected As Expected"
          },
          "parent_step_id": {
            "type": "string",
            "title": "Parent Step Id"
          },
          "capability_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capability Id"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "source_step_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Step Id"
          },
          "resource_ref_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Ref Sha256"
          },
          "requests_used": {
            "type": "integer",
            "title": "Requests Used",
            "default": 0
          },
          "rounds_used": {
            "type": "integer",
            "title": "Rounds Used",
            "default": 0
          },
          "model_calls_used": {
            "type": "integer",
            "title": "Model Calls Used",
            "default": 0
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "step_id",
          "operation_id",
          "method",
          "path_template",
          "outcome",
          "reason",
          "policy_sha256",
          "parent_step_id"
        ],
        "title": "InvestigationResult"
      },
